# Steward dev environment template. Copy to .env at the repo root.
#
#   cp .env.example .env
#
# The docker-compose stack and Django both read this file.
# The defaults below are pre-wired to the bundled local Authentik
# (deploy/compose, `--profile authentik`).

# --- Django ---
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
DATABASE_URL=postgres://steward:steward@db:5432/steward
POSTGRES_DB=steward
POSTGRES_USER=steward
POSTGRES_PASSWORD=steward

# --- OIDC / Authentik (defaults target the bundled dev Authentik) ---
#
# The Authentik blueprint at deploy/compose/authentik-blueprints/steward.yaml
# auto-creates a provider with these credentials on first boot.
#
# Authorization endpoint is hit by the user's BROWSER, so it must use
# localhost. Token/userinfo/JWKS are hit by the Steward CONTAINER, so they
# must use the in-network hostname `authentik-server`.
OIDC_RP_CLIENT_ID=steward
OIDC_RP_CLIENT_SECRET=steward-dev-secret-not-for-production
OIDC_OP_AUTHORIZATION_ENDPOINT=http://localhost:9000/application/o/authorize/
OIDC_OP_TOKEN_ENDPOINT=http://authentik-server:9000/application/o/token/
OIDC_OP_USER_ENDPOINT=http://authentik-server:9000/application/o/userinfo/
OIDC_OP_JWKS_ENDPOINT=http://authentik-server:9000/application/o/steward/jwks/
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES=openid profile email groups
OIDC_VERIFY_SSL=false
# RP-initiated logout endpoint. When set, "log out" redirects through here
# to also terminate the Authentik session (otherwise SSO would silently
# log the user right back in). Leave blank to skip the IdP session kill.
OIDC_OP_END_SESSION_ENDPOINT=http://localhost:9000/application/o/steward/end-session/

# --- Authentik admin API (server-to-server) ---
# Steward calls the Authentik REST API to manage users/groups. The dev
# Authentik blueprint creates a service account with this exact token.
AUTHENTIK_API_URL=http://authentik-server:9000
AUTHENTIK_API_TOKEN=steward-dev-api-token-not-for-production

# The two settings below can be edited from /settings/ in the Steward UI.
# Uncommenting either one here PINS the value: the env value wins and the
# matching field in the UI is rendered read-only with a "locked by env"
# badge. Leave them commented out (the default) to manage them through
# the UI.
#
# Group claim required for access to Steward. Members of this group in
# Authentik are admitted. UI default: steward-admins.
# AUTHENTIK_ADMIN_GROUP=steward-admins
#
# Slug of an Authentik enrollment flow attached to invitations when a new
# member is added. UI default: empty (skip invitations). Authentik does
# not ship an enrollment flow by default; create one in Authentik first.
# AUTHENTIK_INVITE_FLOW=default-source-enrollment
#
# Regex matched (re.search) against Authentik group names. Only matching
# groups appear in Steward's UI -- useful when Authentik has many groups
# but Steward should only surface, say, union-* and committee-*. Empty
# (the default) shows every group.
# AUTHENTIK_GROUP_FILTER=^(union|committee)-

# --- Local Authentik (only used when running `--profile authentik`) ---
AUTHENTIK_TAG=2024.12.3
AUTHENTIK_PG_PASS=authentik-dev
AUTHENTIK_SECRET_KEY=dev-only-replace-me-please-1234567890abcdef
AUTHENTIK_BOOTSTRAP_PASSWORD=akadmin
AUTHENTIK_BOOTSTRAP_EMAIL=akadmin@example.com
